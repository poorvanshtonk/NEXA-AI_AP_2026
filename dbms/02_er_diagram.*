erDiagram
    USERS ||--o{ CONVERSATIONS : owns
    USERS ||--o{ USER_PREFERENCES : has
    USERS ||--o{ USER_DEVICES : registers
    AI_MODELS o|--o{ CONVERSATIONS : may_be_default_for
    CONVERSATIONS ||--o{ MESSAGES : contains
    MESSAGES ||--o{ TOOL_INVOCATIONS : initiates
    TOOL_INTEGRATIONS ||--o{ TOOL_INVOCATIONS : is_used_in

    %% Compound unique constraints are defined in 03_schema.sql:
    %% AI_MODELS(provider, model_name, model_version)
    %% MESSAGES(conversation_id, message_order)

    USERS {
        uuid user_id PK
        text name
        text city
        timestamptz created_at
        timestamptz updated_at
    }

    AI_MODELS {
        uuid model_id PK
        text provider
        text model_name
        text model_version
        jsonb configuration
        timestamptz created_at
        timestamptz updated_at
    }

    CONVERSATIONS {
        uuid conversation_id PK
        uuid user_id FK
        uuid model_id FK
        text title
        boolean is_archived
        timestamptz created_at
        timestamptz updated_at
    }

    MESSAGES {
        uuid message_id PK
        uuid conversation_id FK
        integer message_order
        text role
        text content
        timestamptz created_at
    }

    USER_PREFERENCES {
        uuid user_id PK, FK
        text preference_key PK
        text preference_value
        timestamptz created_at
        timestamptz updated_at
    }

    USER_DEVICES {
        uuid device_id PK
        uuid user_id FK
        text device_name
        text device_type
        text status
        timestamptz created_at
        timestamptz updated_at
    }

    TOOL_INTEGRATIONS {
        uuid tool_id PK
        text tool_code UK
        text display_name
        text category
        boolean is_enabled
        timestamptz created_at
        timestamptz updated_at
    }

    TOOL_INVOCATIONS {
        uuid invocation_id PK
        uuid message_id FK
        uuid tool_id FK
        text status
        jsonb input_payload
        text output_text
        timestamptz started_at
        timestamptz completed_at
    }
